# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="SPPG Vendor Management"
APP_ENV=local
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8000
LICENSE_KEY=

# Production example:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://vendor-sppg.yubawi.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Default local / CI database.
DB_CONNECTION=sqlite

# Production MariaDB / MySQL example:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sql_vendor_sppg_yubawi_com
# DB_USERNAME=
# DB_PASSWORD=

# -----------------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false
# SESSION_CONNECTION=
SESSION_TABLE=sessions
# SESSION_STORE=

# Production HTTPS:
# SESSION_SECURE_COOKIE=true
# Pertahankan SESSION_DOMAIN=null kecuali cookie memang harus dipakai lintas subdomain.

# -----------------------------------------------------------------------------
# Queue, cache, filesystem, broadcast
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

# Optional database queue overrides:
# DB_QUEUE_CONNECTION=
# DB_QUEUE_TABLE=jobs
# DB_QUEUE=default
# DB_QUEUE_RETRY_AFTER=90

CACHE_STORE=database
# CACHE_PREFIX=

# -----------------------------------------------------------------------------
# Redis / Memcached
# -----------------------------------------------------------------------------
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_QUEUE_CONNECTION=default
# REDIS_QUEUE=default
# REDIS_QUEUE_RETRY_AFTER=90

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# Default local / CI: email ditulis ke log dan tidak benar-benar dikirim.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=
MAIL_LOG_CHANNEL=stack

# Production SMTP example.
# Isi sesuai provider SMTP. Untuk port 587 biasanya biarkan MAIL_SCHEME=null
# agar STARTTLS dinegosiasikan oleh mailer; jangan paksa "tls" kecuali provider meminta.
# MAIL_MAILER=smtp
# MAIL_SCHEME=null
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="noreply@vendor-sppg.yubawi.com"
# MAIL_FROM_NAME="${APP_NAME}"
# MAIL_EHLO_DOMAIN=vendor-sppg.yubawi.com

# APP_URL production wajib benar karena signed URL verifikasi email menggunakannya.

# -----------------------------------------------------------------------------
# Phone / WhatsApp verification
# -----------------------------------------------------------------------------
# manual = supplier mengirim pesan ke WhatsApp admin lalu admin memverifikasi nomor secara manual.
# otp = supplier membuktikan kepemilikan nomor HP dengan OTP provider.
# disabled hanya untuk local/testing khusus; production akan menolaknya.
PHONE_VERIFICATION_MODE=manual

# Nomor WhatsApp admin tujuan dalam format internasional tanpa "+" / spasi.
# Contoh: 6281234567890
PHONE_VERIFICATION_WHATSAPP_ADMIN=
PHONE_VERIFICATION_MANUAL_TTL_HOURS=168

# OTP tetap dipertahankan untuk provider OTP di masa depan.
# log hanya untuk local/testing. Production menolak OTP_CHANNEL=log ketika mode=otp.
OTP_CHANNEL=log
OTP_EXPIRES_IN_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_SENDS_PER_IP_PER_HOUR=10
OTP_LOG_CHANNEL=stack

# -----------------------------------------------------------------------------
# Supplier approval signing
# -----------------------------------------------------------------------------
# Secret terpisah untuk menandatangani approval supplier.
# Isi random secret panjang dan berbeda per environment pada production.
SUPPLIER_APPROVAL_SIGNING_KEY=

# -----------------------------------------------------------------------------
# Web Push / PWA
# -----------------------------------------------------------------------------
# Generate VAPID keys per environment dan jangan commit private key production.
VAPID_SUBJECT="mailto:noreply@example.com"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_PEM_FILE=
# WEBPUSH_DB_TABLE=push_subscriptions
# WEBPUSH_DB_CONNECTION=sqlite
WEBPUSH_AUTOMATIC_PADDING=true

# Production example:
# VAPID_SUBJECT="mailto:noreply@vendor-sppg.yubawi.com"

# -----------------------------------------------------------------------------
# AWS / S3 compatible storage
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
